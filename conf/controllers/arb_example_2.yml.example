# Example Arbitrage Controller Configuration 2
# Copy this file to arb_example_2.yml and customize

controller_type: generic
controller_name: arbitrage_controller
id: arb_phl_mexc_bitmart

# Manual kill switch - set to true to pause this controller
manual_kill_switch: false

# Trading amount in quote asset
total_amount_quote: 1100.0

# Exchange and trading pair configuration
exchange_pair_1:
  connector_name: mexc
  trading_pair: PHL-USDT

exchange_pair_2:
  connector_name: bitmart
  trading_pair: PHL-USDT

# Minimum profitability threshold (2.2 = 2.2%)
min_profitability: 0.022

# Delay between executor creations (seconds)
delay_between_executors: 15

# Maximum executor imbalance
max_executors_imbalance: 1

# Rate source for price conversions
rate_connector: binance
quote_conversion_asset: USDT
